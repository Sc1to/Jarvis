[Unit]
Description=Platform Trading Service
After=network.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/Jarvis/platform/trading
ExecStart=/home/jarvis/Jarvis/platform/trading/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8030
Restart=always
RestartSec=5
Environment=PYTHONPATH=/home/jarvis/Jarvis

[Install]
WantedBy=multi-user.target
