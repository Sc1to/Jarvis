[Unit]
Description=Platform Trading Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/platform/trading
ExecStart=/opt/platform/trading/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8030
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/platform

[Install]
WantedBy=multi-user.target
