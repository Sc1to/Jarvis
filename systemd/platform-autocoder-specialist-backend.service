[Unit]
Description=Platform Autocoder Specialist — Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/platform/autocoder/specialists/backend
ExecStart=/opt/platform/autocoder/specialists/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8003
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/platform

[Install]
WantedBy=multi-user.target
