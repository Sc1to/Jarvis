[Unit]
Description=Platform Autocoder Specialist — Backend
After=network.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/Jarvis/platform/autocoder/specialists/backend
ExecStart=/home/jarvis/Jarvis/platform/autocoder/specialists/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8003
Restart=always
RestartSec=5
Environment=PYTHONPATH=/home/jarvis/Jarvis

[Install]
WantedBy=multi-user.target
