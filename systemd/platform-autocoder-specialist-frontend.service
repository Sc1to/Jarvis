[Unit]
Description=Platform Autocoder Specialist — Frontend
After=network.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/Jarvis/platform/autocoder/specialists/frontend
ExecStart=/home/jarvis/Jarvis/platform/autocoder/specialists/frontend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8004
Restart=always
RestartSec=5
Environment=PYTHONPATH=/home/jarvis/Jarvis

[Install]
WantedBy=multi-user.target
