[Unit]
Description=Platform Autocoder Specialist — Frontend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/platform/autocoder/specialists/frontend
ExecStart=/opt/platform/autocoder/specialists/frontend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8004
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/platform

[Install]
WantedBy=multi-user.target
