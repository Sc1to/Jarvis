[Unit]
Description=Platform Bookforge App
After=network.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/Jarvis/platform/bookforge
Environment=BOOKFORGE_DATA_DIR=/opt/platform/data/bookforge
ExecStart=/home/jarvis/Jarvis/platform/bookforge/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8100
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
