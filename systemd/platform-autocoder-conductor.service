[Unit]
Description=Platform Autocoder Conductor
After=network.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/opt/platform/platform/autocoder/conductor
ExecStart=/opt/platform/platform/autocoder/conductor/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/platform

[Install]
WantedBy=multi-user.target
