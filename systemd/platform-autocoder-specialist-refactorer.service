[Unit]
Description=Platform Autocoder Specialist — Refactorer
After=network.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/Jarvis/platform/autocoder/specialists/refactorer
ExecStart=/home/jarvis/Jarvis/platform/autocoder/specialists/refactorer/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8007
Restart=always
RestartSec=5
Environment=PYTHONPATH=/home/jarvis/Jarvis

[Install]
WantedBy=multi-user.target
