[Unit]
Description=Platform Health Monitor
After=network.target platform-admin.service
Wants=platform-admin.service

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/Jarvis
ExecStart=/home/jarvis/Jarvis/scripts/venv/bin/python /home/jarvis/Jarvis/scripts/health-monitor.py
Restart=always
RestartSec=10
Environment=PYTHONPATH=/home/jarvis/Jarvis

[Install]
WantedBy=multi-user.target
