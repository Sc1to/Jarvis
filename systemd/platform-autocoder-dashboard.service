[Unit]
Description=Platform Autocoder Dashboard
After=network.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/Jarvis/platform/autocoder/dashboard
ExecStart=/home/jarvis/Jarvis/platform/autocoder/dashboard/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8050
Restart=always
RestartSec=5
Environment=PYTHONPATH=/home/jarvis/Jarvis

[Install]
WantedBy=multi-user.target
