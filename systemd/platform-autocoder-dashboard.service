[Unit]
Description=Platform Autocoder Dashboard
After=network.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/opt/platform/platform/autocoder/dashboard
ExecStart=/opt/platform/platform/autocoder/dashboard/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8050
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/platform

[Install]
WantedBy=multi-user.target
