[Unit]
Description=Platform Trading Compliance Auditor
After=network.target platform-trading.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/platform/trading
ExecStart=/opt/platform/trading/venv/bin/uvicorn auditor.main:app --host 0.0.0.0 --port 8031
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/platform/trading

[Install]
WantedBy=multi-user.target
