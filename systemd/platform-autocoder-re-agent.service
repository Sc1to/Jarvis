[Unit]
Description=Platform Autocoder RE-Agent (Requirements Elicitation)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/platform/autocoder/re-agent
ExecStart=/opt/platform/autocoder/re-agent/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8002
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/platform

[Install]
WantedBy=multi-user.target
