[Unit]
Description=Platform Autocoder Specialist — DB
After=network.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/Jarvis/platform/autocoder/specialists/db
ExecStart=/home/jarvis/Jarvis/platform/autocoder/specialists/db/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8005
Restart=always
RestartSec=5
Environment=PYTHONPATH=/home/jarvis/Jarvis

[Install]
WantedBy=multi-user.target
