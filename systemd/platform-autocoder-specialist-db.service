[Unit]
Description=Platform Autocoder Specialist — DB
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/platform/autocoder/specialists/db
ExecStart=/opt/platform/autocoder/specialists/db/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8005
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/platform

[Install]
WantedBy=multi-user.target
