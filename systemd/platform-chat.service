[Unit]
Description=Platform Chat Service
After=network.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/Jarvis/platform/chat
ExecStart=/home/jarvis/Jarvis/platform/chat/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8010
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
