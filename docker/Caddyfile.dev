:80 {
    # Named matchers: true when the frontend dist has been built and mounted.
    # Falls back to reverse_proxy when the dist dir is empty (default dev state).
    @admin-built file {
        root /srv/admin
        try_files /index.html
    }
    @chat-built file {
        root /srv/chat
        try_files /index.html
    }
    @writer-built file {
        root /srv/writer
        try_files /index.html
    }
    @coding-built file {
        root /srv/coding
        try_files /index.html
    }
    @autocoder-built file {
        root /srv/autocoder
        try_files /index.html
    }

    # Internal service APIs — declared before the catch-all app handles
    handle /api/conductor* {
        reverse_proxy conductor:8001
    }
    handle /api/re-agent* {
        reverse_proxy re-agent:8002
    }

    # All frontends use /<app>/api as their API base URL; backends have no /api prefix.
    # So /<app>/api/* strips /<app>/api before proxying, /<app>/* strips /<app> for static.

    handle /admin* {
        handle /admin/api* {
            uri strip_prefix /admin/api
            reverse_proxy admin:8000
        }
        handle @admin-built {
            uri strip_prefix /admin
            root * /srv/admin
            try_files {path} /index.html
            file_server
        }
        handle {
            uri strip_prefix /admin
            reverse_proxy admin:8000
        }
    }

    handle /chat* {
        handle /chat/api* {
            uri strip_prefix /chat/api
            reverse_proxy chat:8010
        }
        handle @chat-built {
            uri strip_prefix /chat
            root * /srv/chat
            try_files {path} /index.html
            file_server
        }
        handle {
            uri strip_prefix /chat
            reverse_proxy chat:8010
        }
    }

    handle /writer* {
        handle /writer/api* {
            uri strip_prefix /writer/api
            reverse_proxy writer:8011
        }
        handle @writer-built {
            uri strip_prefix /writer
            root * /srv/writer
            try_files {path} /index.html
            file_server
        }
        handle {
            uri strip_prefix /writer
            reverse_proxy writer:8011
        }
    }

    handle /coding* {
        handle /coding/api* {
            uri strip_prefix /coding/api
            reverse_proxy coding:8012
        }
        handle @coding-built {
            uri strip_prefix /coding
            root * /srv/coding
            try_files {path} /index.html
            file_server
        }
        handle {
            uri strip_prefix /coding
            reverse_proxy coding:8012
        }
    }

    handle /autocoder* {
        handle /autocoder/api* {
            uri strip_prefix /autocoder/api
            reverse_proxy autocoder-dashboard:8050
        }
        handle @autocoder-built {
            uri strip_prefix /autocoder
            root * /srv/autocoder
            try_files {path} /index.html
            file_server
        }
        handle {
            uri strip_prefix /autocoder
            reverse_proxy autocoder-dashboard:8050
        }
    }
}
