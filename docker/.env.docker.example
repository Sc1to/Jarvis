# Copy this file to .env.docker and fill in values
# .env.docker is gitignored — never commit it

DB_PATH=/opt/platform/data/platform.db
PROJECTS_PATH=/opt/platform/data/projects

OLLAMA_URL=http://ollama:11434
CHROMADB_URL=http://chromadb:8020

# Autocoder inter-service URLs (resolved by container name in Docker network)
CONDUCTOR_URL=http://conductor:8001
DASHBOARD_URL=http://autocoder-dashboard:8050

# Models
MODEL_RE_AGENT=qwen2.5:14b
